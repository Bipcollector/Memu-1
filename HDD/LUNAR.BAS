10 REM LUNAR LANDER
20 ALT = 1000
30 VEL = 50
40 FUEL = 300
50 G = 1
60 SAFE = 5
70 PRINT "LUNAR LANDER"
80 PRINT "ALT: "; ALT; " FUEL: "; FUEL;" SPEED: "; VEL
90 IF ALT <= 0 THEN GOTO 300
110 INPUT "BURN FUEL (0-50)"; B
120 IF B < 0 THEN B = 0
130 IF B > 50 THEN B = 50
140 IF B > FUEL THEN B = FUEL
150 REM UPDATE PHYSICS
160 VEL = VEL + G - B
170 ALT = ALT - VEL
180 FUEL = FUEL - B
190 IF FUEL < 0 THEN FUEL = 0
200 GOTO 80
300 ALT = 0
310 PRINT
320 PRINT "TOUCHDOWN!"
330 PRINT "FINAL VELOCITY = "; VEL
340 IF VEL <= SAFE THEN PRINT "SAFE LANDING."
350 IF VEL > SAFE THEN PRINT "CRASH - IMPACT TOO FAST!"
360 PRINT "FUEL REMAINING = "; FUEL
370 END